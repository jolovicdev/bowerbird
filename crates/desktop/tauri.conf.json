{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bowerbird",
  "version": "0.1.1",
  "identifier": "io.github.jolovicdev.bowerbird",
  "build": {
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../../ui/build"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage"
    ],
    "category": "Education",
    "shortDescription": "Ask your own sources and check every answer",
    "macOS": {
      "signingIdentity": "-"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../vendor/pdfium/lib/": "pdfium/",
      "../../vendor/pdfium/LICENSE": "pdfium/LICENSE",
      "../../vendor/pdfium/licenses/": "pdfium/licenses/",
      "../../LICENSE": "LICENSE",
      "../../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md",
      "../../licenses/": "licenses/"
    }
  }
}
